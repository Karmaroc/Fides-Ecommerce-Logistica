    background: none;
    -webkit-background-clip: unset;
    background-clip: unset;
    -webkit-text-fill-color: unset;
    color: #000000;
  }

  .section-title--brand-split .section-title-plain {
    color: #000000;
    -webkit-text-fill-color: #000000;
  }

  .section-title--brand-split .section-title-logo-text {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    animation: none;
    isolation: isolate;
  }

  .section-subtitle {
    font-size: 16px;
    color: var(--gray);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Serviços */
  .servicos {
    background: var(--bg-alt);
  }

  .servicos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .servico-card {
    background: white;
    padding: 32px;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: var(--transition);
  }

  .servico-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .servico-icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    margin-bottom: 20px;
  }

  .servico-card h3 {
    font-size: 20px;
    margin-bottom: 16px;
    color: var(--dark);
  }

  .sistemas-list {
    list-style: none;
  }

  .sistemas-list li {
    padding: 6px 0;
    color: var(--gray);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .sistemas-list i {
    color: var(--gold);
    font-size: 12px;
  }

  /* Diferenciais */
  .diferenciais-grid {
    display: flex;
