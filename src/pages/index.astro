        z-index: 1000;
        transition: var(--transition);
      }

      .dark .navbar {
        background: rgba(0, 0, 0, 0.96);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .nav-content {
        display: flex;
        align-items: center;
