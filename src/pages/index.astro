    titulo: "Frete → Checkout",
    linguagem: "Go",
    descricao:
      "Microserviço Go calculando cotação de frete com timeout e fallback",
    codigo: `package main

import (
    "encoding/json"
    "fmt"
    "net/http"
    "os"
    "time"
)

type Quote struct {
    Carrier string  \`json:"carrier"\`
    Service string  \`json:"service"\`
    Price   float64 \`json:"price"\`
    Days    int     \`json:"days"\`
}

var httpClient = &http.Client{Timeout: 4 * time.Second}

func quoteShipping(w http.ResponseWriter, r *http.Request) {
    cep := r.URL.Query().Get("cep")
    sku := r.URL.Query().Get("sku")
    if cep == "" || sku == "" {
        http.Error(w, "cep e sku são obrigatórios", http.StatusBadRequest)
        return
    }

    url := fmt.Sprintf(
        "https://api.melhorenvio.com.br/v2/me/shipment/calculate?cep=%s&sku=%s",
        cep, sku,
    )

    req, _ := http.NewRequest(http.MethodGet, url, nil)
    req.Header.Set("Authorization", "Bearer "+os.Getenv("MELHOR_ENVIO_TOKEN"))

    resp, err := httpClient.Do(req)
    if err != nil {
        json.NewEncoder(w).Encode([]Quote{{Carrier: "Retirada", Service: "Loja", Price: 0, Days: 1}})
        return
    }
    defer resp.Body.Close()

    if resp.StatusCode >= 400 {
        http.Error(w, "transportadora indisponível", http.StatusBadGateway)
        return
    }

    var quotes []Quote
    json.NewDecoder(resp.Body).Decode(&quotes)

    w.Header().Set("Content-Type", "application/json")
    json.NewEncoder(w).Encode(quotes)
}

func main() {
    http.HandleFunc("/shipping/quote", quoteShipping)
    http.ListenAndServe(":3001", nil)
}`,
  },
];
