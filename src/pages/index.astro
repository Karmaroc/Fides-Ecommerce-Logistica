        background: var(--red);
        color: #ffffff;
      }

      .dark .nav-links a,
      .dark .mobile-menu-btn {
        color: #f3f4f6;
      }

      .dark .nav-links a::after {
        background: #f3f4f6;
      }

      .nav-links {
        display: flex;
        list-style: none;
        gap: 24px;
        flex: 1;
        justify-content: center;
      }

      .nav-links a {
        text-decoration: none;
        color: #ffffff;
        font-weight: 500;
        font-size: 14px;
        transition: var(--transition);
        position: relative;
      }

      .nav-links a::after {
        content: "";
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: #ffffff;
        transition: var(--transition);
      }

      .nav-links a:hover {
        color: #cccccc;
      }

