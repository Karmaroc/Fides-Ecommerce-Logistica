    codigo: `// src/pages/api/webhooks/nuvemshop-pedido.ts
import type { APIRoute } from 'astro';

interface PedidoNuvemshop {
  id: number;
  number: string;
  total: string;
  customer: { name: string; email: string };
  products: Array<{ sku: string; name: string; quantity: number; price: string }>;
}

const toVendaBling = (pedido: PedidoNuvemshop) => ({
  numero: pedido.number,
  cliente: {
    nome: pedido.customer.name,
    email: pedido.customer.email,
  },
  itens: pedido.products.map((produto) => ({
    codigo: produto.sku,
    descricao: produto.name,
    quantidade: produto.quantity,
    valor: Number(produto.price),
  })),
});

export const POST: APIRoute = async ({ request }) => {
  const assinatura = request.headers.get('x-linkedstore-hmac-sha256');
  if (!assinatura) {
    return new Response('Assinatura ausente', { status: 401 });
  }

  const pedido = (await request.json()) as PedidoNuvemshop;
  const venda = toVendaBling(pedido);

  try {
    const response = await fetch('https://www.bling.com.br/Api/v3/pedidos/vendas', {
      method: 'POST',
      headers: {
        Authorization: 'Bearer ' + import.meta.env.BLING_TOKEN,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(venda),
    });

    if (!response.ok) {
      throw new Error('Bling retornou HTTP ' + response.status);
    }

    return Response.json({ ok: true, pedido: pedido.number });
  } catch (error) {
    console.error('Falha ao sincronizar pedido', { pedido: pedido.number, error });
    return Response.json({ ok: false, retry: true }, { status: 502 });
  }
};`,
