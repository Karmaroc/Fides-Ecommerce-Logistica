    codigo: `// src/pages/api/webhooks/nuvemshop-pedido.ts
import type { APIRoute } from 'astro';

interface PedidoNuvemshop {
  id: number;
  number: string;
  total: string;
  customer: { name: string; email: string; address: { zip: string; street: string; number: string; city: string; state: string } };
  products: Array<{ sku: string; name: string; quantity: number; price: string; weight: number }>;
}

const toEnvioMelhorEnvio = (pedido: PedidoNuvemshop) => ({
  service: 1, // PAC
  agency: 1,
  from: {
    name: "Minha Loja",
    phone: "11999999999",
    email: "contato@minhaloja.com",
    document: "12345678000199",
    address: "Rua Exemplo, 123",
    complement: "Sala 1",
    number: "123",
    district: "Centro",
    city: "São Paulo",
    state_abbr: "SP",
    country_id: "BR",
    postal_code: "01234000",
  },
  to: {
    name: pedido.customer.name,
    phone: "11999999999",
    email: pedido.customer.email,
    document: "12345678901",
    address: pedido.customer.address.street,
    complement: "",
    number: pedido.customer.address.number,
    district: "",
    city: pedido.customer.address.city,
    state_abbr: pedido.customer.address.state,
    country_id: "BR",
    postal_code: pedido.customer.address.zip,
  },
  products: pedido.products.map((produto) => ({
    name: produto.name,
    quantity: produto.quantity,
    unitary_value: Number(produto.price),
    weight: produto.weight,
  })),
  volumes: [{
    height: 10,
    width: 10,
    length: 10,
    weight: pedido.products.reduce((total, p) => total + p.weight * p.quantity, 0),
  }],
});

export const POST: APIRoute = async ({ request }) => {
  const assinatura = request.headers.get('x-linkedstore-hmac-sha256');
  if (!assinatura) {
    return new Response('Assinatura ausente', { status: 401 });
  }

  const pedido = (await request.json()) as PedidoNuvemshop;
  const envio = toEnvioMelhorEnvio(pedido);

  try {
    const response = await fetch('https://www.melhorenvio.com.br/api/v2/me/cart', {
      method: 'POST',
      headers: {
        Authorization: 'Bearer ' + import.meta.env.MELHOR_ENVIO_TOKEN,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(envio),
    });

    if (!response.ok) {
      throw new Error('Melhor Envio retornou HTTP ' + response.status);
    }

    return Response.json({ ok: true, pedido: pedido.number });
  } catch (error) {
    console.error('Falha ao gerar envio', { pedido: pedido.number, error });
    return Response.json({ ok: false, retry: true }, { status: 502 });
  }
};`,
  },
