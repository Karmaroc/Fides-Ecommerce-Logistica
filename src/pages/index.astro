  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-background"></div>
    <div class="container">
      <div class="hero-content reveal">
        <h1 class="hero-title">
          Integre seus sistemas com <span class="gradient-text">segurança e agilidade</span>
        </h1>
        <p class="hero-subtitle">
          Conectamos ERPs, e-commerces, gateways de pagamento, CRMs, logística e marketplaces. 
          Automatize processos, reduza erros e escale seu negócio com nossas soluções de integração.
        </p>
        <div class="hero-cta">
          <button class="btn-hero" id="btnHero">
            <i class="fas fa-rocket"></i>
            Solicitar Orçamento
          </button>
          <a href="#exemplos" class="btn-secondary">
            <i class="fas fa-code"></i>
            Ver Exemplos
          </a>
        </div>
        <div class="hero-badges">
          <div class="badge">
            <i class="fas fa-shield-alt"></i>
            <span>Conformidade LGPD</span>
          </div>
          <div class="badge">
            <i class="fas fa-clock"></i>
            <span>Suporte 24/7</span>
          </div>
          <div class="badge">
            <i class="fas fa-check-circle"></i>
            <span>+150 Integrações</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Serviços Section -->
  <section id="servicos" class="section servicos">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="section-title">Sistemas que Integramos</h2>
        <p class="section-subtitle">Conectamos as principais plataformas do mercado brasileiro</p>
      </div>
      <div class="servicos-grid">
        {servicos.map((servico, index) => (
          <div class="servico-card reveal" style={`animation-delay: ${index * 0.1}s`}>
            <div class="servico-icon" style={`background: ${servico.cor}15; color: ${servico.cor}`}>
              <i class={`fas ${servico.icon}`}></i>
            </div>
            <h3>{servico.categoria}</h3>
            <ul class="sistemas-list">
              {servico.sistemas.map(sistema => (
                <li><i class="fas fa-check"></i> {sistema}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Diferenciais Section -->
  <section id="diferenciais" class="section diferenciais">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="section-title section-title--brand-split">
          <span class="section-title-plain">Por que escolher a </span>
          <span class="logo-text section-title-logo-text">
            <span class="logo-fides">FidesTech</span><span class="logo-api">API</span>
          </span>
          <span class="section-title-plain">?</span>
        </h2>
        <p class="section-subtitle">Tecnologia de ponta e expertise para garantir o sucesso das suas integrações</p>
      </div>
      <div class="diferenciais-grid">
        {diferenciais.map((diferencial, index) => (
          <div class="diferencial-card reveal" style={`animation-delay: ${index * 0.1}s`}>
            <div class="diferencial-icon">
              <i class={`fas ${diferencial.icon}`}></i>
            </div>
            <h3>{diferencial.titulo}</h3>
            <p>{diferencial.descricao}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Exemplos de Código Section -->
  <section id="exemplos" class="section exemplos">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="section-title">Exemplos Práticos de Integração</h2>
        <p class="section-subtitle">Veja como implementamos soluções reais para nossos clientes</p>
      </div>
      
      <div class="exemplos-container reveal">
        <div class="ex-tabs" role="tablist">
          {exemplosLinguagens.map((exemplo, index) => (
            <button
              id={`exTab${index}-tab`}
              class={`ex-tab ${index === 0 ? 'active' : ''}`}
              data-tab={`exTab${index}`}
              role="tab"
              aria-controls={`exTab${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <span class="ex-tab-icon">&lt;/&gt;</span>
              <span class="ex-tab-name">{exemplo.titulo}</span>
              <span class="ex-tab-lang">{exemplo.linguagem}</span>
            </button>
          ))}
        </div>

        <div class="ex-panels">
          {exemplosLinguagens.map((exemplo, index) => (
            <div
              class={`ex-panel ${index === 0 ? 'active' : ''}`}
              id={`exTab${index}`}
              role="tabpanel"
              aria-labelledby={`exTab${index}-tab`}
            >
              <div class="ex-panel-header">
                <div>
                  <div class="ex-panel-title">{exemplo.titulo}</div>
                  <div class="ex-panel-desc">{exemplo.descricao}</div>
                </div>
              </div>

              <div class="code-window">
                <div class="code-header">
                  <div class="code-dots">
                    <div class="code-dot red"></div>
                    <div class="code-dot yellow"></div>
                    <div class="code-dot green"></div>
                  </div>
                  <span class="code-title">{exemplo.linguagem}</span>
                </div>
                <div class="code-editor" aria-label={`Código: ${exemplo.titulo}`}>
                  <div class="code-editor-scroll">
                    {getHighlightedCodeLines(exemplo.codigo, exemplo.linguagem).map((line) => (
                      <div class="code-line">
                        <span class="code-line-number">{line.number}</span>
                        <code class="code-line-code" set:html={line.html}></code>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Planos Section -->
  <section id="planos" class="section planos">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="section-title">Planos e Modalidades</h2>
        <p class="section-subtitle">Escolha a melhor opção para o seu negócio</p>
      </div>
      <div class="planos-grid">
        {planos.map((plano, index) => (
          <div class={`plano-card reveal ${plano.destaque ? 'destaque' : ''}`} style={`animation-delay: ${index * 0.1}s`}>
            {plano.destaque && <div class="plano-badge">Mais Popular</div>}
            <h3>{plano.nome}</h3>
            <div class="plano-preco">{plano.preco}</div>
            <p class="plano-descricao">{plano.descricao}</p>
            <ul class="plano-recursos">
              {plano.recursos.map(recurso => (
                <li><i class="fas fa-check-circle"></i> {recurso}</li>
              ))}
            </ul>
            <button class="btn-plano">Escolher Plano</button>
          </div>
        ))}
      </div>
      <div class="planos-footer reveal">
        <p><i class="fas fa-info-circle"></i> Atendemos empresas de todos os portes no Brasil. Entre em contato para um orçamento personalizado.</p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq">
    <div class="container">
      <h2 class="section-title" style="text-align: center; margin-bottom: 40px;">Perguntas Frequentes</h2>
      
      <button id="toggleFaq" class="faq-toggle-btn">
        Mostrar FAQ
      </button>

      <div id="faqWrapper" class="faq-wrapper">
        <div class="faq-container">
          {faqs.map((faq) => (
            <div class="faq-item">
              <button class="faq-question">
                <span>{faq.pergunta}</span>
                <i class="fas fa-plus"></i>
              </button>
              <div class="faq-answer">
                <p>{faq.resposta}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    setTimeout(() => {
      const toggleBtn = document.getElementById('toggleFaq');
      const faqWrapper = document.getElementById('faqWrapper');
      const questions = document.querySelectorAll('.faq-question');
      
      console.log('FAQ Script started - Found questions:', questions.length);
      
      if (toggleBtn && faqWrapper) {
        toggleBtn.addEventListener('click', () => {
          faqWrapper.classList.toggle('show');
          toggleBtn.textContent = faqWrapper.classList.contains('show') ? 'Ocultar FAQ' : 'Mostrar FAQ';
        });
      }
      
      questions.forEach((question, index) => {
        question.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          
          let item = question.parentElement;
          console.log('Question clicked:', index);
          console.log('Parent element:', item);
          console.log('Parent classes before:', item.className);
          
          if (!item) return;
          
          const allItems = document.querySelectorAll('.faq-item');
          
          // Remove active de todos
          allItems.forEach((el) => {
            el.classList.remove('active');
          });
          
          // Sempre adiciona (nunca toggle)
          item.classList.add('active');
          
          console.log('Parent classes after:', item.className);
          console.log('Has active class now:', item.classList.contains('active'));
          console.log('Item HTML:', item.outerHTML.substring(0, 200));
        });
      });
    }, 100);
  </script>

  <!-- Contato Section -->
  <section id="contato" class="section contato">
    <div class="container">
      <div class="contato-content">
        <div class="contato-info reveal">
          <h2>Pronto para integrar seus sistemas?</h2>
          <p>Entre em contato conosco e receba um orçamento personalizado em até 24 horas.</p>
          <div class="contato-detalhes">
            <div class="contato-item">
              <i class="fas fa-envelope"></i>
              <div>
                <strong>E-mail</strong>
                <p>contato@fidestech.api</p>
              </div>
            </div>
            <div class="contato-item">
              <i class="fas fa-phone"></i>
              <div>
                <strong>Telefone</strong>
                <p>(32) 99951-3968</p>
              </div>
            </div>
            <div class="contato-item">
              <i class="fas fa-map-marker-alt"></i>
              <div>
                <strong>Localização</strong>
                <p>Visconde do Rio Branco, MG - Brasil</p>
              </div>
            </div>
          </div>
          <div class="social-links">
            <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
            <a href="#" aria-label="GitHub"><i class="fab fa-github"></i></a>
            <a href="#" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
            <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
          </div>
        </div>
        
        <div class="contato-form reveal">
          <form id="formContato">
            <div class="form-group">
              <label for="nome">Nome Completo</label>
              <input type="text" id="nome" name="nome" required />
            </div>
            <div class="form-group">
              <label for="email">E-mail</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
              <label for="telefone">Telefone</label>
              <input type="tel" id="telefone" name="telefone" />
            </div>
            <div class="form-group">
              <label for="mensagem">Mensagem</label>
              <textarea id="mensagem" name="mensagem" rows="5" required></textarea>
            </div>
            <button type="submit" class="btn-submit">
              <i class="fas fa-paper-plane"></i>
              Enviar Mensagem
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-logo">
          <span class="logo-text">
            <span class="logo-fides">FidesTech</span>
            <span class="logo-api">API</span>
          </span>
        </div>
        <p class="footer-text">
          Soluções de integração de APIs para empresas que buscam automação, segurança e escalabilidade.
        </p>
        <p class="footer-copy">
          &copy; <span id="anoAtual"></span> <span class="logo-text" style="display: inline-flex; gap: 4px; align-items: center;"><span class="logo-fides" style="background: linear-gradient(135deg, #E63946 0%, #DC143C 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-family: 'Share Tech Mono', monospace; font-weight: 400; letter-spacing: 1px;">FidesTech</span><span class="logo-api" style="background: linear-gradient(135deg, #C0C0C0 0%, #E8E8E8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-family: 'Saira Stencil One', cursive; font-weight: 400; letter-spacing: 2px; font-size: 1.3em;">API</span></span>. Todos os direitos reservados.
        </p>
      </div>
    </div>
  </footer>

  <!-- Botão Scroll to Top -->
  <button class="scroll-top" id="scrollTop">
    <i class="fas fa-arrow-up"></i>
  </button>


<style>
  /* Reset e Variáveis */
  :root {
    --primary: #000000;
    --gold: #D4AF37;
    --gold-dark: #B8941F;
    --red: #DC143C;
    --red-dark: #B8001F;
    --dark: #000000;
    --gray: #4a4a4a;
    --light-gray: #e0e0e0;
    --bg: #FFFFFF;
    --bg-alt: #fafafa;
    --shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.15);
    --radius: 16px;
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--dark);
    background: var(--bg);
    line-height: 1.6;
    overflow-x: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Navbar */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: #000000;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
    z-index: 1000;
    transition: var(--transition);
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 700;
  }

  .logo-img {
    width: 40px;
    height: 40px;
    display: block;
  }

  .logo-text {
    display: flex;
    gap: 4px;
    align-items: center;
    animation: slideInFromLeft 1s ease-out;
  }

  .logo-fides {
    background: linear-gradient(135deg, #E63946 0%, #DC143C 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-family: 'Share Tech Mono', monospace;
    font-weight: 400;
    letter-spacing: 1px;
  }

  .logo-api {
    background: linear-gradient(135deg, #C0C0C0 0%, #E8E8E8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-family: 'Saira Stencil One', cursive;
    font-weight: 400;
    letter-spacing: 2px;
    font-size: 1.3em;
  }

  @keyframes slideInFromLeft {
    0% {
      opacity: 0;
      transform: translateX(-100px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 24px;
  }

  .nav-links a {
    text-decoration: none;
    color: #FFFFFF;
    font-weight: 500;
    font-size: 14px;
    transition: var(--transition);
    position: relative;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #FFFFFF;
    transition: var(--transition);
  }

  .nav-links a:hover {
    color: #cccccc;
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    font-size: 24px;
    color: #FFFFFF;
    cursor: pointer;
  }

  /* Buttons */
  .btn-primary, .btn-hero, .btn-secondary, .btn-plano, .btn-submit {
    padding: 10px 24px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: var(--transition);
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--gold);
    color: #000000;
    border: 2px solid var(--gold);
  }

  .btn-primary:hover {
    background: var(--gold-dark);
    border-color: var(--gold-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(212, 175, 55, 0.4);
  }

  .btn-hero {
    background: var(--red);
    color: #FFFFFF;
    font-size: 16px;
    padding: 14px 32px;
    border: 2px solid var(--red);
  }

  .btn-hero:hover {
    background: var(--red-dark);
    border-color: var(--red-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(220, 20, 60, 0.4);
  }

  .btn-secondary {
    background: transparent;
    color: var(--gold);
    border: 2px solid var(--gold);
    text-decoration: none;
    padding: 12px 30px;
  }

  .btn-secondary:hover {
    background: var(--gold);
    color: #000000;
  }

  /* Hero Section */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 100px;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    z-index: -1;
  }

  .hero-background::before {
    content: '';
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #000000 0%, transparent 70%);
    opacity: 0.03;
    top: -200px;
    right: -200px;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-content {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 20px;
    color: var(--dark);
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--gold) 0%, var(--red) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-weight: 900;
  }

  .hero-subtitle {
    font-size: 18px;
    color: var(--gray);
    margin-bottom: 32px;
    line-height: 1.7;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-bottom: 48px;
  }

  .hero-badges {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: white;
    border-radius: 50px;
    box-shadow: var(--shadow);
    font-weight: 500;
    font-size: 14px;
  }

  .badge i {
    color: var(--red);
    font-size: 18px;
  }

  /* Section */
  .section {
    padding: 80px 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-title {
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 12px;
    background: linear-gradient(135deg, var(--gold) 0%, var(--red) 50%, #000000 100%);
