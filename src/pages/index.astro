@RestController
@RequestMapping("/api/nfe")
public class NfeController {

    private final WebClient sefaz;
    private final WebClient financeiro;

    @Value("\${sefaz.api.key}")
    private String apiKey;

    public NfeController(WebClient.Builder builder) {
        this.sefaz = builder.baseUrl("https://api.sefaz.rs.gov.br").build();
        this.financeiro = builder.baseUrl("https://financeiro.empresa.com.br").build();
    }

    @GetMapping("/{chave}")
    public Mono<ResponseEntity<NfeDto>> consultarNfe(@PathVariable String chave) {
        return sefaz.get()
            .uri("/v1/nfe/{chave}", chave)
            .header("X-Api-Key", apiKey)
            .retrieve()
            .bodyToMono(NfeDto.class)
            .flatMap(nfe -> financeiro.post()
                .uri("/api/documentos-fiscais")
                .bodyValue(new DocumentoFiscalDto(chave, nfe.status(), nfe.valorTotal()))
                .retrieve()
                .toBodilessEntity()
                .thenReturn(ResponseEntity.ok(nfe)))
            .onErrorReturn(ResponseEntity.status(502).build());
    }
}`,
