        flex-wrap: wrap;
      }

      .badge {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 24px;
        background: white;
        border-radius: 50px;
        box-shadow: var(--shadow);
        font-weight: 500;
        font-size: 14px;
      }

      .dark .badge {
        background: rgba(255, 255, 255, 0.08);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
        color: #f8fafc;
      }

      .dark .badge i {
        color: var(--red);
      }

      .badge i {
        color: var(--red);
        font-size: 18px;
      }

      /* Section */
      .section {
        padding: 80px 0;
      }

      .section-header {
        text-align: center;
        margin-bottom: 48px;
      }

      .section-title {
        font-size: 36px;
        font-weight: 700;
        margin-bottom: 12px;
        background: linear-gradient(
          135deg,
          var(--purple) 0%,
          var(--red) 50%,
          var(--dark) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .section-title.section-title--brand-split {
        background: none;
        -webkit-background-clip: unset;
        background-clip: unset;
        -webkit-text-fill-color: unset;
        color: #000000;
      }

      .section-title--brand-split .section-title-plain {
        color: #000000;
        -webkit-text-fill-color: #000000;
      }

      .section-title--brand-split .section-title-logo-text {
        display: inline-flex;
        gap: 4px;
        align-items: center;
        animation: none;
        isolation: isolate;
      }

      .section-subtitle {
        font-size: 16px;
        color: var(--gray);
        max-width: 600px;
        margin: 0 auto;
      }

      /* Serviços */
      .servicos {
        background: var(--bg-alt);
      }

      .servicos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
      }

      .servico-card {
        background: white;
        padding: 36px;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        transition: var(--transition);
      }

      .dark .servicos,
      .dark .diferenciais,
      .dark .exemplos,
      .dark .faq {
        background: #080808;
      }

      .dark .servico-card,
      .dark .diferencial-card,
      .dark .exemplos-container,
      .dark .plano-card,
      .dark .faq-item,
      .dark .faq-answer,
      .dark .planos-footer {
        background: #111111;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
      }

      .dark .hero-badges {
        gap: 18px;
      }

      .dark .hero-title,
      .dark .hero-subtitle,
      .dark .section-title,
      .dark .section-subtitle,
      .dark .servico-card h3,
      .dark .subcategoria h4,
      .dark .sistemas-list li,
      .dark .diferencial-card h3,
      .dark .diferencial-card p,
      .dark .plano-card h3,
      .dark .plano-descricao,
      .dark .plano-recursos li,
      .dark .faq-question,
      .dark .faq-answer p {
        color: #f8fafc;
      }

      .dark .section-title.section-title--brand-split,
      .dark .section-title--brand-split .section-title-plain,
      .dark .section-title--brand-split .section-title-logo-text {
        color: #f8fafc;
        -webkit-text-fill-color: #f8fafc;
      }

      .servico-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow-lg);
      }

      .servico-icon {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 20px;
      }

      .servico-card h3 {
        font-size: 20px;
        margin-bottom: 16px;
        color: var(--dark);
      }

      .servico-descricao {
        font-size: 14px;
        color: var(--gray);
        margin-bottom: 16px;
        line-height: 1.5;
      }

      .subcategoria {
        margin-bottom: 20px;
      }

      .subcategoria h4 {
        font-size: 16px;
        font-weight: 600;
        color: var(--dark);
        margin-bottom: 8px;
      }

      .subcategoria p {
        font-size: 13px;
        color: var(--gray);
        margin-bottom: 10px;
        line-height: 1.4;
      }

      .sistemas-list {
        list-style: none;
      }

      .sistemas-list li {
        padding: 6px 0;
        color: var(--gray);
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
      }

      .sistemas-list i {
        color: var(--purple);
        font-size: 12px;
      }

      /* Diferenciais */
      .diferenciais-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 24px;
        max-width: 1000px;
        margin: 0 auto;
      }

      .diferencial-card {
        text-align: center;
        padding: 36px 24px;
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        transition: var(--transition);
        flex: 0 1 calc(33.333% - 16px);
        min-width: 260px;
      }

      .diferencial-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow-lg);
        border: 2px solid var(--purple);
      }

      .diferencial-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 20px;
        background: linear-gradient(135deg, var(--purple) 0%, var(--red) 100%);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 26px;
      }

      .diferencial-card h3 {
        font-size: 18px;
        margin-bottom: 10px;
        color: var(--dark);
      }

      .diferencial-card p {
        color: var(--gray);
        line-height: 1.6;
        font-size: 14px;
      }

      /* Exemplos */
      .exemplos {
        background: var(--bg-alt);
      }

      .exemplos-container {
        background: #111318;
        border-radius: 32px;
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.28);
        overflow: hidden;
        max-width: 1080px;
        width: 100%;
        margin: 0 auto;
        border: 1px solid rgba(255, 255, 255, 0.05);
      }

      .integration-examples {
        background: #0d1119;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 32px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .lang-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: center;
      }

      .lang-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 18px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.03);
        color: rgba(255, 255, 255, 0.72);
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease,
          color 0.2s ease;
        font-family: "Share Tech Mono", monospace;
        font-size: 13px;
        font-weight: 600;
      }

      .lang-btn:hover {
        background: rgba(255, 255, 255, 0.06);
      }

      .lang-btn.active {
        border-color: rgba(255, 255, 255, 0.18);
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
      }

      .lang-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
      }

      .ld-ts {
        background: #3b82f6;
      }
      .ld-go {
        background: #06b6d4;
      }

      .lang-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        font-family: "Share Tech Mono", monospace;
        font-size: 10px;
        color: rgba(255, 255, 255, 0.7);
      }

      .lang-pane {
        display: none;
      }
      .lang-pane.active {
        display: block;
      }

      .window {
        background: #0a0d14;
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.35);
      }

      .window-head {
        display: grid;
        grid-template-columns: 72px 1fr auto;
        align-items: center;
        gap: 16px;
        padding: 18px 20px;
        background: linear-gradient(180deg, #11151f 0%, #0c1018 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .traffic {
        display: flex;
        gap: 8px;
      }

      .tl {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
      }

      .tl-r {
        background: #ff5f56;
      }
      .tl-y {
        background: #ffbd2e;
      }
      .tl-g {
        background: #27c93f;
      }

      .tab-row {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding-bottom: 2px;
        scrollbar-width: none;
      }

      .tab-row::-webkit-scrollbar {
        display: none;
      }

      .tab {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        color: rgba(255, 255, 255, 0.72);
        cursor: pointer;
        white-space: nowrap;
        font-size: 13px;
        font-weight: 600;
        transition: color 0.2s ease, border-color 0.2s ease,
          background 0.2s ease;
      }

      .tab:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.04);
      }
      .tab.active {
        color: #ffffff;
        border-bottom-color: #3b82f6;
      }

      .tab-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 3px 8px;
        border-radius: 999px;
        font-family: "Share Tech Mono", monospace;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: #ffffff;
      }

      .tb-ts {
        background: #3b82f6;
      }
      .tb-go {
        background: #06b6d4;
      }

      .window-actions {
        display: flex;
        align-items: center;
      }

      .btn-copy {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
        color: rgba(255, 255, 255, 0.8);
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease,
          border-color 0.2s ease;
        font-size: 12px;
        font-weight: 700;
      }

      .btn-copy svg {
        display: block;
        width: 14px;
        height: 14px;
      }
      .btn-copy:hover {
        background: rgba(255, 255, 255, 0.06);
      }
      .btn-copy.copied {
        background: rgba(74, 222, 128, 0.12);
        border-color: rgba(74, 222, 128, 0.3);
        color: #4ade80;
      }

      .panels {
        position: relative;
      }
      .panel {
        display: none;
      }
      .panel.active {
        display: flex;
        flex-direction: column;
      }

      .panel-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 20px;
        background: #0a0d14;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        flex-wrap: wrap;
      }

      .panel-info-left {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .panel-filename {
        font-family: "Share Tech Mono", monospace;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.52);
      }

      .panel-flow {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: rgba(255, 255, 255, 0.72);
      }

      .panel-info-right {
        display: flex;
        align-items: center;
      }
      .panel-lc {
        font-family: "Share Tech Mono", monospace;
        font-size: 11px;
        color: rgba(255, 255, 255, 0.52);
      }

      .code-area {
        background: #080c14;
      }

      .code-scroll {
        height: min(540px, 60vh);
        min-height: 300px;
        overflow: auto;
        outline: none;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.16) transparent;
      }

      .code-scroll::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      .code-scroll::-webkit-scrollbar-track {
        background: transparent;
      }
      .code-scroll::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.16);
        border-radius: 999px;
      }

      .code-table {
        border-collapse: collapse;
        width: 100%;
        padding: 12px 0;
      }

      .cr {
        vertical-align: top;
      }

      .ln {
        width: 52px;
        min-width: 52px;
        padding: 0 14px 0 10px;
        text-align: right;
        font-family: "Share Tech Mono", monospace;
        font-size: 12px;
        line-height: 22px;
        color: rgba(255, 255, 255, 0.36);
        user-select: none;
        border-right: 1px solid rgba(255, 255, 255, 0.06);
        background: #070a11;
        position: sticky;
        left: 0;
      }

      .lc {
        padding: 0 28px 0 16px;
      }

      .lc code {
        display: block;
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        line-height: 22px;
        color: #e5e7ff;
        white-space: pre;
      }

      .t-kw {
        color: #c678dd;
        font-style: italic;
      }
      .t-str {
        color: #98c379;
      }
      .t-num {
        color: #d19a66;
      }
      .t-cmt {
        color: #4b5263;
        font-style: italic;
      }
      .t-type {
        color: #e5c07b;
      }
      .t-op {
        color: #56b6c2;
      }
      .t-tag {
        color: #e06c75;
      }

      .panel-foot {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 20px;
        background: #0b0f18;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        flex-wrap: wrap;
      }

      .pf-title {
        font-size: 12px;
        font-weight: 700;
        color: #ffffff;
      }

      .pf-desc {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.68);
        line-height: 1.5;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .code-panel {
        display: none;
        padding: 32px;
        background: #0f1115;
      }

      .code-panel.active {
        display: block;
      }

      .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 26px;
        flex-wrap: wrap;
      }

      .panel-title {
        margin: 0;
        font-size: 1.25rem;
        line-height: 1.2;
        font-weight: 800;
        color: #ffffff;
        max-width: 72%;
      }

      .panel-description {
        margin: 8px 0 0;
        color: #9aa1b9;
        font-size: 0.95rem;
        line-height: 1.7;
        max-width: 100%;
      }

      .panel-meta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        color: #9da6c2;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .code-window {
        background: #15171b;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
      }

      .code-header {
        background: linear-gradient(180deg, #23262f 0%, #191b22 100%);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .code-dots {
        display: flex;
        gap: 10px;
        align-items: center;
      }

      .code-dot {
        width: 12px;
        height: 12px;
        border-radius: 999px;
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.28) inset,
          0 1px 2px rgba(0, 0, 0, 0.22);
      }

      .code-dot.red {
        background: #ff5f56;
      }

      .code-dot.yellow {
        background: #ffbd2e;
      }

      .code-dot.green {
        background: #27c93f;
      }

      .code-title {
        justify-self: end;
        color: #d7d7dd;
        font-family: "Poppins", sans-serif;
        font-size: 12px;
        font-weight: 600;
        line-height: 1;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.06);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
      }

      .code-editor {
        height: min(460px, 62vh);
        min-height: 300px;
        width: 100%;
        background: #15171b;
        overflow: hidden;
        color: #d4d4d4;
        font-family: "Share Tech Mono", "Consolas", "Monaco", monospace;
        font-size: 13.5px;
        line-height: 22px;
      }

      .code-editor-scroll {
        height: 100%;
        overflow: auto;
        padding: 20px 0;
      }

      .code-line {
        display: grid;
        grid-template-columns: 50px minmax(0, 1fr);
        min-height: 24px;
        align-items: start;
      }

      .code-line-number {
        color: #6b7280;
        text-align: right;
        padding: 0 12px 0 10px;
        user-select: none;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        background: #15171b;
        position: sticky;
        left: 0;
      }

      .code-line-code {
        display: block;
        padding-left: 16px;
        padding-right: 24px;
        white-space: pre;
        word-break: normal;
      }

      .syntax-keyword {
        color: #c586c0;
      }

      .syntax-string {
        color: #ce9178;
      }

      .syntax-comment {
        color: #6a9955;
        font-style: italic;
      }

      .syntax-number {
        color: #b5cea8;
      }

      .syntax-punctuation {
        color: #d4d4d4;
      }

      /* Planos */
      .planos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        margin-bottom: 32px;
      }

      .plano-card {
        background: white;
        border-radius: var(--radius);
        padding: 32px;
        box-shadow: var(--shadow);
        transition: var(--transition);
        position: relative;
        border: 2px solid transparent;
      }

      .plano-card:hover {
        transform: translateY(-6px);
        box-shadow: var(--shadow-lg);
      }

      .plano-card.destaque {
        border-color: var(--purple);
        box-shadow: 0 16px 48px rgba(139, 92, 246, 0.3);
      }

      .plano-badge {
        position: absolute;
        top: -10px;
        right: 20px;
        background: linear-gradient(135deg, var(--purple) 0%, var(--red) 100%);
        color: #ffffff;
        padding: 5px 14px;
        border-radius: 50px;
        font-size: 11px;
        font-weight: 600;
      }

      .plano-card h3 {
        font-size: 24px;
        margin-bottom: 12px;
        color: var(--dark);
      }

      .plano-preco {
        font-size: 28px;
        font-weight: 700;
        background: linear-gradient(135deg, var(--purple) 0%, var(--red) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 12px;
      }

      .plano-descricao {
        color: var(--gray);
        margin-bottom: 24px;
        min-height: 42px;
        font-size: 14px;
      }

      .plano-recursos {
        list-style: none;
        margin-bottom: 24px;
      }

      .plano-recursos li {
        padding: 10px 0;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
      }

      .plano-recursos i {
        color: var(--purple);
        font-size: 16px;
      }

      .btn-plano {
        width: 100%;
        background: linear-gradient(135deg, var(--purple) 0%, var(--red) 100%);
        color: #ffffff;
        justify-content: center;
        border: 2px solid var(--purple);
      }

      .btn-plano:hover {
        background: linear-gradient(
          135deg,
          var(--purple-dark) 0%,
          var(--red-dark) 100%
        );
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(139, 92, 246, 0.4);
      }

      .planos-footer {
        text-align: center;
        padding: 24px;
        background: rgba(0, 0, 0, 0.05);
        border-radius: var(--radius);
      }

      .planos-footer p {
        color: var(--gray);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 14px;
      }

      .planos-footer i {
        color: var(--red);
        font-size: 18px;
      }

      /* FAQ */
      .faq {
        background: var(--bg-alt);
        padding: 80px 20px;
        text-align: center;
      }

      .faq-wrapper {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: max-height 0.5s ease, opacity 0.4s ease;
      }

      .faq-wrapper.show {
        max-height: 5000px;
        opacity: 1;
      }

      .faq-toggle-btn {
        background: var(--purple);
        color: white;
        border: none;
        padding: 14px 28px;
        border-radius: 999px;
        cursor: pointer;
        font-weight: 700;
        margin-bottom: 30px;
        transition: 0.3s;
      }

      .faq-toggle-btn:hover {
        transform: translateY(-2px);
      }

      .faq-container {
        max-width: 800px;
        margin: 0 auto;
      }

      .faq-item {
        background: white;
        border-radius: var(--radius);
        margin-bottom: 16px;
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .faq-question {
        width: 100%;
        padding: 20px;
        background: none;
        border: none;
        text-align: left;
        font-size: 16px;
        font-weight: 600;
        color: var(--dark);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .faq-question i {
        color: var(--gold);
        font-size: 16px;
        transition: transform 0.3s ease;
      }

      .faq-item.active .faq-question i {
        transform: rotate(180deg);
      }

      .faq-answer {
        display: none;
        padding: 0;
      }

      .faq-item.active .faq-answer {
        display: block;
        padding: 20px;
        background: #f9f9f9;
      }

      .dark .faq-item.active .faq-answer {
        background: #111111;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
      }

      .faq-answer p {
        color: var(--gray);
        line-height: 1.7;
        font-size: 14px;
        margin: 0;
      }

      /* Contato */
      .contato {
        background: #000000;
        color: white;
      }

      .contato-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        align-items: start;
      }

      .contato-info h2 {
        font-size: 32px;
        margin-bottom: 12px;
      }

      .contato-info > p {
        font-size: 16px;
        margin-bottom: 32px;
        opacity: 0.9;
      }

      .contato-detalhes {
        margin-bottom: 32px;
      }

      .contato-item {
        display: flex;
        gap: 16px;
        margin-bottom: 20px;
      }

      .contato-item i {
        font-size: 20px;
        width: 44px;
        height: 44px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .contato-item strong {
        display: block;
        margin-bottom: 4px;
        font-size: 14px;
      }

      .contato-item p {
        opacity: 0.9;
        font-size: 14px;
      }

      .social-links {
        display: flex;
        gap: 12px;
      }

      .social-links a {
        width: 44px;
        height: 44px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
        transition: var(--transition);
      }

      .social-links a:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: translateY(-3px);
      }

      .contato-form {
        background: white;
        padding: 32px;
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
      }

      .dark .contato-form {
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.05);
      }

      .form-group {
        margin-bottom: 20px;
      }

      .form-group label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: var(--dark);
        font-size: 14px;
      }

      .form-group input,
      .form-group textarea {
        width: 100%;
        padding: 12px;
        border: 2px solid var(--light-gray);
        border-radius: 10px;
        font-family: inherit;
        font-size: 14px;
        transition: var(--transition);
        background-color: #FFFFFF;
        color: var(--dark);
      }

      .dark .form-group input,
      .dark .form-group textarea {
        background-color: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.1);
        color: #FFFFFF;
      }

      .form-group input:focus,
      .form-group textarea:focus {
        outline: none;
        border-color: var(--gold);
      }

      .form-group textarea {
        resize: vertical;
      }

      .btn-submit {
        width: 100%;
        background: linear-gradient(135deg, var(--gold) 0%, var(--red) 100%);
        color: #ffffff;
        justify-content: center;
        border: none;
      }

      .btn-submit:hover {
        background: linear-gradient(
          135deg,
          var(--gold-dark) 0%,
          var(--red-dark) 100%
        );
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
      }

      /* Footer */
      .footer {
        background: #000000;
        color: white;
        padding: 48px 0;
        text-align: center;
      }

      .footer-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 12px;
      }

      .footer-logo .logo-img {
        width: 36px;
        height: 36px;
      }

      .footer-logo .logo-text {
        display: flex;
        gap: 4px;
        align-items: center;
      }

      .footer-logo .logo-fides {
        background: linear-gradient(135deg, #e63946 0%, #dc143c 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-family: "Share Tech Mono", monospace;
        font-weight: 400;
        letter-spacing: 1px;
      }

      .footer-logo .logo-api {
        background: linear-gradient(135deg, #c0c0c0 0%, #e8e8e8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-family: "Saira Stencil One", cursive;
        font-weight: 400;
        letter-spacing: 2px;
        font-size: 1.3em;
        font-weight: 800;
      }

      .footer-text {
        max-width: 600px;
        margin: 0 auto 20px;
        opacity: 0.8;
        font-size: 14px;
      }

      .footer-copy {
        opacity: 0.6;
        font-size: 13px;
      }

      /* Scroll to Top */
      .scroll-top {
        position: fixed;
        bottom: 24px;
        right: 24px;
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, var(--gold) 0%, var(--red) 100%);
        color: white;
        border: none;
        border-radius: 50%;
        font-size: 18px;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transition: var(--transition);
        z-index: 999;
        box-shadow: 0 4px 12px rgba(212, 175, 55, 0.4);
      }

      .scroll-top.visible {
        opacity: 1;
        visibility: visible;
      }

      .scroll-top:hover {
        background: linear-gradient(
          135deg,
          var(--gold-dark) 0%,
          var(--red-dark) 100%
        );
        transform: translateY(-3px);
        box-shadow: 0 6px 16px rgba(212, 175, 55, 0.6);
      }

      /* Animations */
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .reveal {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.6s ease, transform 0.6s ease;
      }

      .reveal.active {
        opacity: 1;
        transform: translateY(0);
      }

      /* Responsive */
      @media (max-width: 968px) {
        .nav-links {
          display: none;
        }

        .mobile-menu-btn {
          display: block;
        }

        .hero-title {
          font-size: 36px;
        }

        .hero-subtitle {
          font-size: 16px;
        }

        .hero-cta {
          flex-direction: column;
          align-items: center;
        }

        .section {
          padding: 60px 0;
        }

        .section-title {
          font-size: 28px;
        }

        .section-subtitle {
          font-size: 15px;
        }

        .diferencial-card {
          flex: 0 1 calc(50% - 12px);
        }

        .contato-content {
          grid-template-columns: 1fr;
          gap: 32px;
        }

        .panel-header {
          padding: 14px 16px;
        }

        .panel-title {
          font-size: 18px;
        }

        .panel-description {
          font-size: 12px;
        }

        .code-header {
          grid-template-columns: 72px 1fr 72px;
          padding: 10px 12px;
        }

        .code-dot {
          width: 10px;
          height: 10px;
        }

        .code-title {
          font-size: 11px;
          padding: 6px 10px;
        }

        .code-editor {
          height: min(420px, 55vh);
          min-height: 260px;
          font-size: 13px;
        }

        .code-line {
          grid-template-columns: 44px minmax(max-content, 1fr);
        }

        .code-line-number {
          padding-right: 10px;
        }

        .code-line-code {
          padding-left: 12px;
        }
      }

      @media (max-width: 640px) {
        .hero {
          padding-top: 80px;
        }

        .hero-title {
          font-size: 28px;
        }

        .hero-subtitle {
          font-size: 15px;
        }

        .section {
          padding: 48px 0;
        }

        .section-title {
          font-size: 24px;
        }

        .section-subtitle {
          font-size: 14px;
        }

        .servicos-grid,
        .planos-grid {
          grid-template-columns: 1fr;
        }

        .diferencial-card {
          flex: 0 1 100%;
        }

        .diferenciais-grid {
          justify-content: stretch;
        }

        .panel-header {
          padding: 18px 24px;
        }

        .panel-title {
          font-size: 20px;
        }

        .panel-description {
          font-size: 13px;
        }

        .code-header {
          grid-template-columns: 62px 1fr 62px;
          padding: 10px 12px;
        }

        .code-dot {
          width: 12px;
          height: 12px;
        }

        .code-title {
          font-size: 11px;
          padding: 6px 10px;
        }

        .code-editor {
          height: min(480px, 58vh);
          min-height: 280px;
          font-size: 12.5px;
        }

        .code-line {
          grid-template-columns: 40px minmax(max-content, 1fr);
        }

        .code-line-number {
          padding-left: 8px;
          padding-right: 8px;
        }

        .code-line-code {
          padding-left: 10px;
        }

        .badge {
          font-size: 13px;
          padding: 8px 16px;
        }

        .badge i {
          font-size: 16px;
        }
      }
    </style>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // ── Reveal on scroll ──────────────────────────────────────────
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("active");
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
        );
        document
          .querySelectorAll(".reveal")
          .forEach((el) => revealObserver.observe(el));

        // ── Integration examples tabs ──────────────────────────────────
        const langBtns = document.querySelectorAll(".lang-btn");
        const langPanes = document.querySelectorAll(".lang-pane");
        const tabButtons = document.querySelectorAll(".tab");

        langBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            const lang = btn.getAttribute("data-lang");
            if (!lang) return;

            langBtns.forEach((item) => {
              item.classList.remove("active");
              item.setAttribute("aria-pressed", "false");
            });

            langPanes.forEach((pane) => pane.classList.remove("active"));
            document
              .querySelector(`.lang-pane[data-lang-pane="${lang}"]`)
              ?.classList.add("active");

            btn.classList.add("active");
            btn.setAttribute("aria-pressed", "true");

            document
              .querySelectorAll(`.tab[data-lang="${lang}"]`)
              .forEach((tab, index) => {
                tab.classList.toggle("active", index === 0);
                tab.setAttribute(
                  "aria-selected",
                  index === 0 ? "true" : "false"
                );
              });
            document
              .querySelectorAll(`.panel[data-lang="${lang}"]`)
              .forEach((panel, index) => {
                panel.classList.toggle("active", index === 0);
              });
          });
        });

        tabButtons.forEach((tab) => {
          tab.addEventListener("click", () => {
            const targetId = tab.getAttribute("data-tab");
            const lang = tab.getAttribute("data-lang");
            if (!targetId || !lang) return;

            document
              .querySelectorAll(`.tab[data-lang="${lang}"]`)
              .forEach((item) => {
                item.classList.remove("active");
                item.setAttribute("aria-selected", "false");
              });

            document
              .querySelectorAll(`.panel[data-lang="${lang}"]`)
              .forEach((panel) => {
                panel.classList.remove("active");
              });

            tab.classList.add("active");
            tab.setAttribute("aria-selected", "true");
            
            const targetPanel = document.querySelector(`.panel[data-panel="${targetId}"]`);
            if (targetPanel) {
              targetPanel.classList.add("active");
            }
          });
        });

        document.querySelectorAll(".btn-copy").forEach((button) => {
          button.addEventListener("click", async () => {
            const windowEl = button.closest(".window");
            if (!windowEl) return;
            const panel = windowEl.querySelector(".panel.active");
            if (!panel) return;
            
            const code = panel.getAttribute("data-code") || "";

            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(code);
              } else {
                // Fallback for older browsers
                const textArea = document.createElement("textarea");
                textArea.value = code;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand("copy");
                document.body.removeChild(textArea);
              }
              
              button.classList.add("copied");
              const label = button.querySelector("span");
              if (label) label.textContent = "Copiado!";
              setTimeout(() => {
                if (label) label.textContent = "Copiar";
                button.classList.remove("copied");
              }, 2200);
            } catch (error) {
              console.warn("Não foi possível copiar o código", error);
            }
          });
        });

        // ── FAQ accordion ─────────────────────────────────────────────
        document.querySelectorAll(".faq-question").forEach((question) => {
          question.addEventListener("click", () => {
            const item = question.parentElement;
            if (!item) return;
            const isActive = item.classList.contains("active");

            document
              .querySelectorAll(".faq-item")
              .forEach((i) => i.classList.remove("active"));

            if (!isActive) item.classList.add("active");
          });
        });

        // Toggle Expand FAQ Wrapper
        const toggleBtn = document.getElementById("toggleFaq");
        const faqWrapper = document.getElementById("faqWrapper");

        if (toggleBtn && faqWrapper) {
          toggleBtn.addEventListener("click", () => {
            faqWrapper.classList.toggle("show");
            toggleBtn.textContent = faqWrapper.classList.contains("show")
              ? "Ocultar FAQ"
              : "Mostrar FAQ";
          });
        }

        // ── Scroll suave → contato ────────────────────────────────────
        const contatoSection = document.getElementById("contato");

        function scrollToContato() {
          contatoSection?.scrollIntoView({ behavior: "smooth" });
        }

        document
          .getElementById("btnHero")
          ?.addEventListener("click", scrollToContato);
        document
          .getElementById("btnContatoNav")
          ?.addEventListener("click", scrollToContato);
        document
          .querySelectorAll(".btn-plano")
          .forEach((btn) => btn.addEventListener("click", scrollToContato));

        // ── Formulário de contato ─────────────────────────────────────
        document
          .getElementById("formContato")
          ?.addEventListener("submit", (e) => {
            e.preventDefault();

            const nome = (
              document.getElementById("nome") as HTMLInputElement
            ).value.trim();
            const email = (
              document.getElementById("email") as HTMLInputElement
            ).value.trim();
            const mensagem = (
              document.getElementById("mensagem") as HTMLTextAreaElement
            ).value.trim();

            if (nome && email && mensagem) {
              alert(
                `Mensagem enviada com sucesso!\n\nObrigado, ${nome}! Entraremos em contato em breve pelo e-mail ${email}.`
              );
              (e.target as HTMLFormElement).reset();
            } else {
              alert("Por favor, preencha todos os campos obrigatórios.");
            }
          });

        // ── Scroll to Top ─────────────────────────────────────────────
        const scrollTopBtn = document.getElementById("scrollTop");

        window.addEventListener("scroll", () => {
          scrollTopBtn?.classList.toggle("visible", window.scrollY > 500);
        });

        scrollTopBtn?.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        // ── Ano atual no rodapé ───────────────────────────────────────
        const anoEl = document.getElementById("anoAtual");
        if (anoEl) anoEl.textContent = String(new Date().getFullYear());

        // ── Mobile menu ───────────────────────────────────────────────
        const mobileMenuBtn = document.getElementById("mobileMenuBtn");
        const navLinks = document.querySelector(
          ".nav-links"
        ) as HTMLElement | null;

        mobileMenuBtn?.addEventListener("click", () => {
          if (!navLinks) return;

          const isOpen = navLinks.style.display === "flex";
          navLinks.style.display = isOpen ? "none" : "flex";

          if (!isOpen) {
            Object.assign(navLinks.style, {
              position: "absolute",
              top: "80px",
              left: "0",
              right: "0",
              background: "#000000",
              flexDirection: "column",
              padding: "20px",
              boxShadow: "0 10px 30px rgba(0,0,0,0.3)",
            });
          }
        });

        document.querySelectorAll(".nav-links a").forEach((link) => {
          link.addEventListener("click", () => {
            if (window.innerWidth <= 968 && navLinks) {
              navLinks.style.display = "none";
            }
          });
        });

        // Theme toggle
        const themeToggle = document.getElementById("theme-toggle");
        const body = document.body;
        const icon = themeToggle?.querySelector("i");

        // Check for saved theme preference or default to light mode
        const currentTheme = localStorage.getItem("theme") || "light";
        if (currentTheme === "dark") {
          body.classList.add("dark");
          if (icon) {
            icon.classList.remove("fa-moon");
            icon.classList.add("fa-sun");
          }
        }

        if (themeToggle) {
          themeToggle.addEventListener("click", () => {
            body.classList.toggle("dark");
            const isDark = body.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");

            if (icon) {
              if (isDark) {
                icon.classList.remove("fa-moon");
                icon.classList.add("fa-sun");
              } else {
                icon.classList.remove("fa-sun");
                icon.classList.add("fa-moon");
              }
            }
          });
        }
      });
    </script>
  </body>
</html>
