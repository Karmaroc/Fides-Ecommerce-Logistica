        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .dark {
        --primary: #000000;
        --purple: #dc143c;
        --purple-dark: #b8001f;
        --red: #dc143c;
        --red-dark: #b8001f;
        --dark: #ffffff;
