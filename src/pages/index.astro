        align-items: center;
        gap: 10px;
        font-size: 20px;
        font-weight: 700;
      }

      .logo-img {
        width: 40px;
        height: 40px;
        display: block;
      }

      .logo-text {
        display: flex;
        gap: 4px;
        align-items: center;
        animation: slideInFromLeft 1s ease-out;
      }

