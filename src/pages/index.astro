    codigo: `# backend/conciliacao_pagamentos.py
from fastapi import FastAPI, HTTPException, Header
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import httpx
import os

app = FastAPI(title="Conciliação Mercado Pago")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["https://fidestechapi.com.br"],
    allow_methods=["*"],
)

class EventoPagamento(BaseModel):
    payment_id: str
    pedido_id: str
    cliente_email: str

MP_TOKEN = os.environ["MP_ACCESS_TOKEN"]
CRM_TOKEN = os.environ["CRM_TOKEN"]

@app.post("/webhooks/mercado-pago")
async def conciliar_pagamento(
    evento: EventoPagamento,
    x_api_key: str = Header(...)
):
    if x_api_key != os.environ["WEBHOOK_SECRET"]:
        raise HTTPException(status_code=401, detail="Não autorizado")

    async with httpx.AsyncClient() as client:
        pagamento = await client.get(
            f"https://api.mercadopago.com/v1/payments/{evento.payment_id}",
            headers={"Authorization": f"Bearer {MP_TOKEN}"},
            timeout=10.0,
        )
        pagamento.raise_for_status()
        dados = pagamento.json()

        if dados["status"] != "approved":
            return {"ok": True, "acao": "aguardar_confirmacao"}

        negocio = await client.post(
            "https://api.pipedrive.com/v1/deals",
            params={"api_token": CRM_TOKEN},
            json={
                "title": f"Pedido {evento.pedido_id}",
                "value": dados["transaction_amount"],
                "status": "won",
                "person_email": evento.cliente_email,
            },
            timeout=10.0,
        )
        negocio.raise_for_status()

    return {"ok": True, "pedido": evento.pedido_id}`,
