    codigo: `// src/main.rs — Axum server
use axum::{extract::{Query, State}, http::StatusCode, routing::get, Json, Router};
use reqwest::Client;
use serde::{Deserialize, Serialize};
use std::sync::Arc;

#[derive(Clone)]
struct AppState {
    client: Client,
    api_key: String,
}

#[derive(Deserialize)]
struct Params { sku: String, loja: Option<String> }

#[derive(Serialize, Deserialize)]
struct Estoque {
    sku: String,
    loja: String,
    quantidade: u32,
    reservado: u32,
    disponivel: bool,
}

async fn buscar_estoque(
    Query(params): Query<Params>,
    State(state): State<Arc<AppState>>,
) -> Result<Json<Estoque>, StatusCode> {
    let loja = params.loja.unwrap_or_else(|| "matriz".to_string());
    let url = format!("https://api.wms.com.br/v1/lojas/{}/estoque/{}", loja, params.sku);

    let estoque = state.client
        .get(url)
        .bearer_auth(&state.api_key)
        .send()
        .await
        .map_err(|_| StatusCode::BAD_GATEWAY)?
        .json::<Estoque>()
        .await
        .map_err(|_| StatusCode::BAD_GATEWAY)?;

    Ok(Json(estoque))
}

#[tokio::main]
async fn main() {
    let state = Arc::new(AppState {
        client: Client::new(),
        api_key: std::env::var("WMS_API_KEY").unwrap(),
    });

    let app = Router::new().route("/estoque", get(buscar_estoque)).with_state(state);
    let listener = tokio::net::TcpListener::bind("0.0.0.0:3002").await.unwrap();
    axum::serve(listener, app).await.unwrap();
}`,
  },
