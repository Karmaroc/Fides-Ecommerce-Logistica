    codigo: `<?php
declare(strict_types=1);

readonly class EstoqueErpClient
{
    public function __construct(
        private string $baseUrl,
        private string $apiKey,
    ) {}

    public function atualizar(string $sku, int $quantidade): array
    {
        $payload = [
            'sku' => $sku,
            'quantidade' => $quantidade,
            'origem' => 'woocommerce',
            'sincronizado_em' => date(DATE_ATOM),
        ];

        $ch = curl_init($this->baseUrl . '/v1/estoque');
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_POST           => true,
            CURLOPT_POSTFIELDS     => json_encode($payload),
            CURLOPT_TIMEOUT        => 10,
            CURLOPT_HTTPHEADER     => [
                'Content-Type: application/json',
                "Authorization: Bearer {$this->apiKey}",
            ],
        ]);

        $response = curl_exec($ch);
        $status   = curl_getinfo($ch, CURLINFO_HTTP_CODE);
        curl_close($ch);

        if ($response === false || $status >= 400) {
            throw new \RuntimeException("ERP retornou erro HTTP {$status}");
        }

        return json_decode((string) $response, true, flags: JSON_THROW_ON_ERROR);
    }
}

$payload = json_decode(file_get_contents('php://input'), true);
$sku = trim((string) ($payload['sku'] ?? ''));
$quantidade = (int) ($payload['stock_quantity'] ?? -1);

if ($sku === '' || $quantidade < 0) {
    http_response_code(422);
    echo json_encode(['erro' => 'Payload inválido']);
    exit;
}

$client = new EstoqueErpClient($_ENV['ERP_BASE_URL'], $_ENV['ERP_API_KEY']);

try {
    $resultado = $client->atualizar($sku, $quantidade);
    http_response_code(200);
    echo json_encode(['ok' => true, 'data' => $resultado]);
} catch (\RuntimeException $e) {
    http_response_code(502);
    echo json_encode(['erro' => $e->getMessage()]);
}`,
