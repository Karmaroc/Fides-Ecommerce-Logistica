function escapeHtml(value: string): string {
  return value.replace(/[&<>]/g, (char) => htmlEscapes[char]);
}

function escapeRegExp(value: string): string {
  return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function tokenMarker(index: number): string {
  let value = index;
  let name = "";

  do {
    name = String.fromCharCode(65 + (value % 26)) + name;
    value = Math.floor(value / 26) - 1;
  } while (value >= 0);

  return `\uE000${name}\uE001`;
}

function findCommentStart(line: string, linguagem: string): number {
  const markers =
    linguagem === "Python"
      ? ["#"]
      : linguagem === "PHP 8.2"
      ? ["//", "#"]
      : ["//"];
  let quote: string | null = null;
  let escaped = false;

  for (let index = 0; index < line.length; index += 1) {
    const char = line[index];

    if (quote) {
      if (escaped) {
        escaped = false;
      } else if (char === "\\") {
        escaped = true;
      } else if (char === quote) {
        quote = null;
      }
      continue;
    }

    if (char === '"' || char === "'" || char === "`") {
      quote = char;
      continue;
    }

    if (markers.some((marker) => line.startsWith(marker, index))) {
      return index;
    }
  }

  return -1;
}

function highlightCodeLine(rawLine: string, linguagem: string): string {
  const tokens = new Map<string, string>();

  function stash(value: string, className: string): string {
    const marker = tokenMarker(tokens.size);
    tokens.set(
      marker,
      `<span class="syntax-${className}">${escapeHtml(value)}</span>`
    );
    return marker;
  }

  const commentStart = findCommentStart(rawLine, linguagem);
  const comment = commentStart >= 0 ? rawLine.slice(commentStart) : "";
  let line = commentStart >= 0 ? rawLine.slice(0, commentStart) : rawLine;

  line = line.replace(
    /(`(?:\\.|[^`])*`|"(?:\\.|[^"])*"|'(?:\\.|[^'])*')/g,
    (match) => stash(match, "string")
  );

  const keywords = languageKeywords[linguagem] ?? [];
  if (keywords.length > 0) {
    const keywordPattern = new RegExp(
      `\\b(${keywords.map(escapeRegExp).join("|")})\\b`,
      "g"
    );
    line = line.replace(keywordPattern, (match) => stash(match, "keyword"));
  }

  line = line.replace(/\b(\d+(?:\.\d+)?)\b/g, (match) =>
    stash(match, "number")
  );
  line = line.replace(/([{}()[\].,;:])/g, (match) =>
    stash(match, "punctuation")
  );
  line = escapeHtml(line);

  if (comment) {
    line += stash(comment, "comment");
  }

  tokens.forEach((html, marker) => {
    line = line.replaceAll(marker, html);
  });

  return line || "&nbsp;";
}

function getHighlightedCodeLines(codigo: string, linguagem: string) {
  return codigo
    .replace(/\r\n/g, "\n")
    .split("\n")
    .map((line, index) => ({
      number: index + 1,
      html: highlightCodeLine(line, linguagem),
    }));
}

